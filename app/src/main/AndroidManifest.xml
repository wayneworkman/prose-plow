<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network permission, and none may be added: the model runs on the device and the app
         never uses the network. The five permissions below are everything the app asks for: four
         let an answer be finished while the app is not on screen, and one keeps the background
         maintenance job scheduled across restarts of the phone. Together with the few that
         libraries merge in they are held to an allow-list by the verify*Manifest tasks in
         app/build.gradle.kts, which fail the build on anything else (android.permission.INTERNET
         above all). -->

    <!-- The answer service: a foreground service, of the "special use" type on Android 14 and
         later (see the service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Its ongoing notification, and the one that says an answer is ready. Asked for once, on
         Android 13 and later; refused, nothing else changes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The processor stays awake while an answer is written with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The background maintenance job is kept across restarts of the phone (JobInfo's
         setPersisted), which Android allows only with this. No receiver of the app listens for the
         boot: the platform's job scheduler does. Used only while "Background maintenance" is on;
         with it off the job is cancelled. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ProsePlowApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProsePlow">

        <!-- taskAffinity is empty on purpose. With the default affinity (the package name),
             another app on Android 9 or 10 can declare an activity with the same affinity and
             have it placed in this app's task, where it comes up in place of the lock screen and
             can ask for the passphrase ("task hijacking"; Android 11 closed this). An activity
             without an affinity belongs to no task but its own. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ProsePlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the process alive and awake while an answer is written out of sight; it does
             nothing else and takes no commands (background/AnswerService.kt). Not exported: only
             the app itself can start it. "specialUse" because no named type describes running a
             language model on the device; the property states the use, as Android asks. -->
        <service
            android:name=".background.AnswerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Finishes an answer that a language model on this device is writing for the user, after the user has left the app or the screen has turned off." />
        </service>

        <!-- The background maintenance job (background/MaintenanceJob.kt): every few hours it lets
             the lock delete what has expired, and does nothing else. Not exported; the permission
             attribute says that only the system's job scheduler may bind it (it is a requirement
             on whoever binds, not a permission this app asks for). -->
        <service
            android:name=".background.MaintenanceJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Privacy: androidx.emoji2 (pulled in by Compose) registers EmojiCompatInitializer, which
             asks the Google Play Services downloadable-fonts provider for an emoji font and can
             cause a download from Google. That request is made by another process, so having no
             INTERNET permission does not prevent it. The app must cause no network traffic at
             all, so that initializer is removed; the other androidx.startup initializers stay.
             MissingClass is ignored because androidx.startup is only a transitive runtime
             dependency (not on the compile classpath lint checks); the class is in the APK. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
