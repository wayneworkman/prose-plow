<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a pen nib ploughing the first of three furrows. 108dp canvas, content
     in the 66dp safe zone. White shapes only, with the nib's slit cut out rather than drawn over,
     so the same drawable serves as the monochrome (themed icon) layer, which keeps only alpha. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Nib, point down, with its breather hole and slit as an even-odd cut-out -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M49,26h10v7l7,7c0,8 -6,16 -12,24c-6,-8 -12,-16 -12,-24l7,-7zM53,58L53,44.83A3,3 0,1 1,55 44.83L55,58z" />
    <!-- Furrows; the first is parted by the point of the nib -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,64H47M61,64H78M34,73H74M41,82H67" />
</vector>
