+        // proseplow: the two lists above receive the token id of every restored cell, and both
+        // are freed when this function returns, by whichever of its ways out. They are
+        // overwritten first, so that reading a state back leaves the ids of a conversation in no
+        // freed block (through a volatile pointer: stores into memory that is freed next would
+        // otherwise be removed).
+        struct wipe_token_ids {
+            llama_ubatch                   & ubatch;
+            std::vector<llama_kv_cell_ext> & exts;
+            uint32_t                         n;
+
+            static void zero(void * data, size_t size) {
+                volatile unsigned char * p = (volatile unsigned char *) data;
+                while (size-- > 0) {
+                    *p++ = 0;
+                }
+            }
+
+            ~wipe_token_ids() {
+                zero(ubatch.token, (size_t) n * sizeof(llama_token));
+                zero(exts.data(), exts.size() * sizeof(llama_kv_cell_ext));
+            }
+        } wipe_token_ids_on_return { ubatch, exts, cell_count };
+
