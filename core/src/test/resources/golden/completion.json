{
  "format": "completion",
  "note": "Written by hand. A model that only continues text has no chat template, so there is nothing to render and generate_golden.py neither writes nor checks this file. Each expected prompt follows the reference script of Glint-Research/Shard-2 (infer.py): it tokenises the prompt text exactly as given, adds no token of its own, and prints the prompt followed directly by what the model wrote. So the prompt is the latest user message as it is, and for a continued message that text followed directly by the partial answer.",
  "cases": [
    {
      "name": "single message",
      "mode": "generate",
      "messages": [
        {
          "role": "user",
          "content": "The capital of France is"
        }
      ],
      "rendered": "The capital of France is"
    },
    {
      "name": "a space at the end is kept",
      "mode": "generate",
      "messages": [
        {
          "role": "user",
          "content": "Once upon a time "
        }
      ],
      "rendered": "Once upon a time "
    },
    {
      "name": "whitespace at both ends is kept",
      "mode": "generate",
      "messages": [
        {
          "role": "user",
          "content": "\n  Dear diary,\n\n"
        }
      ],
      "rendered": "\n  Dear diary,\n\n"
    },
    {
      "name": "whitespace that a chat template would strip is kept",
      "mode": "generate",
      "messages": [
        {
          "role": "user",
          "content": "\u00a0\u3000text\u0085\t"
        }
      ],
      "rendered": "\u00a0\u3000text\u0085\t"
    },
    {
      "name": "earlier turns are not part of the prompt",
      "mode": "generate",
      "messages": [
        {
          "role": "user",
          "content": "First text"
        },
        {
          "role": "assistant",
          "content": " and what was written after it"
